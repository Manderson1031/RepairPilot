# Production beta API (public URL, not a secret)
EXPO_PUBLIC_API_URL=https://repairpilot-api.onrender.com

# Visual-only screen preview. Set true while reviewing layout in Expo Go.
# Start screens: home, equipment, diagnose, history, scanner, ar,
# maintenance, settings. Preview data is local and writes are disabled.
EXPO_PUBLIC_PREVIEW_MODE=false
EXPO_PUBLIC_PREVIEW_SCREEN=home

# For local development, replace with your computer's LAN address, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
