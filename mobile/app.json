{
  "expo": {
    "name": "RepairPilot",
    "slug": "repairpilot",
    "version": "0.13.0",
    "scheme": "repairpilot",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.repairpilot.app",
      "buildNumber": "13"
    },
    "android": {
      "package": "com.repairpilot.app",
      "versionCode": 13,
      "permissions": [
        "CAMERA"
      ]
    }
  }
}
