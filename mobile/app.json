{
  "expo": {
    "name": "RepairPilot",
    "slug": "repairpilot",
    "version": "0.16.0",
    "scheme": "repairpilot",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow RepairPilot to use the camera to photograph equipment and parts for diagnosis.",
          "photosPermission": "Allow RepairPilot to access selected equipment photos for diagnosis.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.repairpilot.app",
      "buildNumber": "16"
    },
    "android": {
      "package": "com.repairpilot.app",
      "versionCode": 16
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "751be404-bdbb-43a9-986e-c586cd0ca02b"
      }
    },
    "owner": "manderson1031"
  }
}
