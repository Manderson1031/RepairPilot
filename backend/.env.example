REPAIRPILOT_ENV=development
REPAIRPILOT_SECRET=change-this-to-a-long-random-secret
REPAIRPILOT_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
REPAIRPILOT_RATE_LIMIT=60/minute
REPAIRPILOT_MAX_IMAGE_MB=12
REPAIRPILOT_MAX_PDF_MB=30
